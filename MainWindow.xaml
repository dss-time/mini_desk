<Window x:Class="MiniDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniDesk" Width="1180" Height="820" MinWidth="960" MinHeight="680" Language="{DynamicResource CurrentLanguage}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="13" ShadowDepth="2" Direction="270" Color="#23446D" Opacity="0.08" />
        <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="14" /><Setter Property="MinHeight" Value="94" />
        </Style>
        <Style x:Key="MiniIconTile" TargetType="Border">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Background" Value="#E8F2FF" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0"><Image Source="/Assets/MiniDesk-256.png" Width="34" Height="34" /><TextBlock Text="MiniDesk" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" /></StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="HomeNav" Tag="Home" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Home}" /></StackPanel></Button>
                    <Button x:Name="GroupsNav" Tag="Groups" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA5;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Groups}" /></StackPanel></Button>
                    <Button x:Name="SnapshotsNav" Tag="Snapshots" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Snapshots}" /></StackPanel></Button>
                    <Button x:Name="AppearanceNav" Tag="Appearance" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Appearance}" /></StackPanel></Button>
                    <Button x:Name="QuickNav" Tag="Quick" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Quick}" /></StackPanel></Button>
                    <Button x:Name="AboutNav" Tag="About" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_About}" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="8,0,0,0"><TextBlock Text="{DynamicResource Sidebar_Line1}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /><TextBlock Text="{DynamicResource Sidebar_Line2}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="HomePage" Margin="32,28">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid VerticalAlignment="Center" MaxWidth="760">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.32*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="27" FontWeight="SemiBold"><Run Text="{DynamicResource Home_Title}" /><Run Text="👋" FontFamily="Segoe UI Emoji" /></TextBlock><TextBlock Text="{DynamicResource Home_Subtitle}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,24" /><Button Content="{DynamicResource Home_Start}" Width="238" Height="46" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="GoGroups_Click" /></StackPanel>
                    <Image x:Name="HomeIllustration" Grid.Column="1" Source="/Assets/Home-Folder-Illustration.png" Width="250" Height="220"
                           HorizontalAlignment="Right" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <UniformGrid Grid.Row="1" Columns="4" MaxWidth="760" Margin="0,34,0,0">
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,8,0"><StackPanel><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="#DDF7E9"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="#12A660" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource Home_Organize}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_OrganizeDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                    <Border Style="{StaticResource FeatureCard}" Margin="4,0"><StackPanel><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="#E9E8FF"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="#6156E9" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource Home_Collapse}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_CollapseDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                    <Border Style="{StaticResource FeatureCard}" Margin="4,0"><StackPanel><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="#FFF0E6"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#F36B27" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource Nav_Snapshots}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_SnapshotDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                    <Border Style="{StaticResource FeatureCard}" Margin="8,0,0,0"><StackPanel><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource Home_Appearance}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_AppearanceDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                </UniformGrid>
            </Grid>

            <Grid x:Name="GroupsPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="{DynamicResource Nav_Groups}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Groups_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel><Button x:Name="NewGroupButton" Content="{DynamicResource Groups_New}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="38" Click="NewGroup_Click" AutomationProperties.AutomationId="NewGroup" /></Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" CornerRadius="10,10,0,0" Background="#F6F9FD" Padding="14,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="78" /><ColumnDefinition Width="124" /><ColumnDefinition Width="76" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="{DynamicResource Groups_Name}" FontSize="10" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="2" Text="{DynamicResource Groups_Items}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="3" Text="{DynamicResource Groups_State}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="4" Text="{DynamicResource Groups_AutoCollapse}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="5" Text="{DynamicResource Groups_Actions}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /></Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" CornerRadius="0,0,12,12" BorderThickness="1,0,1,1" Padding="8,2,8,8">
                    <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E8EEF6" BorderThickness="0,0,0,1" Padding="6,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="78" /><ColumnDefinition Width="124" /><ColumnDefinition Width="76" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{Binding Accent, Converter={StaticResource HexBrush}}"><Grid><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" /><Image Source="{Binding IconPath, Converter={StaticResource GroupIcon}}" Stretch="Uniform" Margin="3" /></Grid></Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding ItemCount}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ComboBox Grid.Column="3" SelectedIndex="{Binding StateIndex}" SelectionChanged="GroupState_Changed" Margin="4,0"><ComboBoxItem Content="{DynamicResource State_Expanded}" /><ComboBoxItem Content="{DynamicResource State_Collapsed}" /><ComboBoxItem Content="{DynamicResource State_IconOnly}" /></ComboBox>
                            <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" Checked="GroupEnabled_Changed" Unchecked="GroupEnabled_Changed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="82" Height="34" Padding="8,0" Margin="0,0,6,0" ToolTip="{DynamicResource Groups_Rename}" AutomationProperties.Name="{DynamicResource Groups_Rename}" Click="RenameGroup_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" /><TextBlock Text="{DynamicResource Groups_Rename}" Margin="6,0,0,0" /></StackPanel></Button><Button Width="70" Height="34" Padding="8,0" ToolTip="{DynamicResource Groups_Delete}" AutomationProperties.Name="{DynamicResource Groups_Delete}" Click="DeleteGroup_Click" Style="{StaticResource DangerButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" /><TextBlock Text="{DynamicResource Groups_Delete}" Margin="6,0,0,0" /></StackPanel></Button></StackPanel>
                        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid x:Name="SnapshotsPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="{DynamicResource Nav_Snapshots}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Snapshots_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel><Button Content="{DynamicResource Snapshots_Create}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="38" Click="CreateSnapshot_Click" AutomationProperties.AutomationId="CreateSnapshot" /></Grid>
                <ListBox x:Name="SnapshotList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,11" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Padding="12" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="112" Height="66" CornerRadius="8" Background="#DCEBFF"><Image Source="/Assets/MiniDesk-256.png" Width="48" Height="48" Opacity="0.88" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" /><Border Background="#FFF0E7" CornerRadius="7" Padding="6,2" Margin="9,0,0,0"><TextBlock Text="{DynamicResource Snapshots_Manual}" Foreground="#E86E36" FontSize="9" /></Border></StackPanel><TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6,0,0"><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:g}}" /><Run Text="{DynamicResource Snapshot_Contains}" /><Run Text="{Binding GroupCount, Mode=OneWay}" /><Run Text="{DynamicResource Snapshot_GroupsSuffix}" /></TextBlock></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource Snapshots_Restore}" Style="{StaticResource PrimaryButton}" Height="34" Click="RestoreSnapshot_Click" Margin="0,0,8,0" /><Button Content="···" Style="{StaticResource IconButton}" FontWeight="Bold" Click="SnapshotMore_Click"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource Snapshots_Preview}" Click="PreviewSnapshot_Click" /><Separator /><MenuItem Header="{DynamicResource Snapshots_Delete}" Foreground="#D9384E" Click="DeleteSnapshot_Click" /></ContextMenu></Button.ContextMenu></Button></StackPanel>
                    </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,22,28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{DynamicResource Nav_Appearance}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Appearance_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" /></StackPanel>
                        <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="154" VerticalAlignment="Top" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Appearance_Language}">
                            <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                            <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingCard}" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_Theme}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_ThemeHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SystemTheme" Tag="System" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="0,0,5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_System}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_SystemDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="LightTheme" Tag="Light" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="2,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" Foreground="#E99A32" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_Light}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_LightDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="DarkTheme" Tag="Dark" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="5,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_Dark}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_DarkDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Appearance_Preview}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_PreviewHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,2,0,0" /></StackPanel>
                                <Border x:Name="PreviewScene" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Height="132" Background="#D8E9F9" CornerRadius="10" ClipToBounds="True">
                                    <Grid><Border x:Name="PreviewSceneTint" Background="#2888D5" Opacity="0.55" CornerRadius="10" /><Border x:Name="PreviewSceneAccent" Background="#0D55BD" Width="210" Height="180" CornerRadius="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,-105" />
                                        <Border x:Name="PreviewPanel" Background="Transparent" CornerRadius="16" BorderBrush="#AFFFFFFF" BorderThickness="1" Width="260" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <!-- Alpha and corner geometry are applied to the same background/card values as DesktopGroupWindow. -->
                                                <Border x:Name="PreviewSurface" Background="#FFF5F9FF" CornerRadius="16" />
                                                <Grid x:Name="PreviewExpandedContents" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <DockPanel x:Name="PreviewExpandedHeader"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="PreviewExpandedIcon" Width="24" Height="24" CornerRadius="7" Background="#2675F5" Margin="0,0,7,0"><Grid><TextBlock x:Name="PreviewExpandedGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewExpandedCustomIcon" Stretch="Uniform" Margin="2" /></Grid></Border><TextBlock x:Name="PreviewExpandedName" Text="{DynamicResource Appearance_Development}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel><TextBlock Text="⌃" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
                                                    <Grid Grid.Row="1" Margin="0,6,0,0"><ItemsControl x:Name="PreviewItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center" Margin="2,0"><Image Source="{Binding Path, Converter={StaticResource ShellIcon}}" Width="28" Height="28" Stretch="Uniform" /><TextBlock Text="{Binding Name}" FontSize="8" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="PreviewItemsEmptyHint" Text="{DynamicResource Group_EmptyHint}" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
                                                </Grid>
                                                <Grid x:Name="PreviewCollapsedContent" Visibility="Collapsed" Margin="9"><Grid x:Name="PreviewCollapsedLayout">
                                                    <Border x:Name="PreviewCollapsedIcon" Width="38" Height="38" CornerRadius="10" Background="#2675F5"><Grid><TextBlock x:Name="PreviewCollapsedGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewCollapsedCustomIcon" Stretch="Uniform" Margin="4" /></Grid></Border>
                                                    <TextBlock x:Name="PreviewCollapsedName" Grid.Column="1" Text="{DynamicResource Appearance_Development}" FontWeight="SemiBold" FontSize="14" Margin="11,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border x:Name="PreviewCollapsedBadge" Grid.Column="2" Background="#130C315F" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="PreviewCollapsedCount" Text="0" Foreground="#566681" FontSize="11" /></Border>
                                                </Grid></Grid>
                                                <Border x:Name="PreviewIconOnlyContent" Visibility="Collapsed" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"><Border x:Name="PreviewOnlyIcon" Width="38" Height="38" CornerRadius="10" Background="#2675F5"><Grid><TextBlock x:Name="PreviewOnlyGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewOnlyCustomIcon" Stretch="Uniform" Margin="4" /></Grid></Border></Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,10,0,0" VerticalAlignment="Center"><Button x:Name="PreviewExpandedButton" Content="{DynamicResource Preview_Expanded}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="PreviewExpanded_Click" /><Button x:Name="PreviewCollapsedButton" Content="{DynamicResource Preview_Collapsed}" Margin="0,0,0,6" Click="PreviewCollapsed_Click" /><Button x:Name="PreviewIconOnlyButton" Content="{DynamicResource Preview_IconOnly}" Click="PreviewIconOnly_Click" /></StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource SettingCard}" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_CollapseStyle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_CollapseHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="CapsuleStyle" Tag="HorizontalCapsule" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="0,0,5,0"><StackPanel HorizontalAlignment="Center"><Border Width="42" Height="12" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" HorizontalAlignment="Center" Margin="0,7,0,10" /><TextBlock Text="{DynamicResource Collapse_Capsule}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="VerticalStyle" Tag="VerticalIcon" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="2,0"><StackPanel HorizontalAlignment="Center"><Border Width="22" Height="34" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,5"><TextBlock Text="♫" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource Collapse_Vertical}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="IconStyle" Tag="IconOnly" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="5,0,0,0"><StackPanel HorizontalAlignment="Center"><Ellipse Width="22" Height="22" Fill="{DynamicResource ControlBrush}" Margin="0,6,0,11" /><TextBlock Text="{DynamicResource Collapse_IconOnly}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Appearance_Monitors}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_MonitorsHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,8,0" /></StackPanel><Button x:Name="RefreshMonitorsButton" Grid.Column="1" Content="{DynamicResource Appearance_DetectMonitors}" Click="RefreshMonitors_Click" Padding="8,5" /></Grid>
                                <ItemsControl x:Name="MonitorList" Grid.Row="1" Margin="0,8,0,7"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8"><StackPanel><Grid Height="52" Background="#EAF3FC" ClipToBounds="True"><Border Background="#2380D7" Opacity="0.65" CornerRadius="8" /><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"><Run Text="{Binding WorkArea.Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding WorkArea.Height, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ScalePercent, Mode=OneWay}" /><Run Text="%" /></TextBlock><TextBlock Text="{Binding PrimaryLabel, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <WrapPanel Grid.Row="2"><CheckBox Content="{DynamicResource Appearance_RememberMonitorLayout}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,12,4" /><CheckBox Content="{DynamicResource Appearance_MoveToPrimary}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,12,4" /><CheckBox Content="{DynamicResource Appearance_RestoreOnReconnect}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,0,4" /></WrapPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource SettingCard}" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_Parameters}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_ParametersHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,8" />
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_Opacity}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding PanelOpacity}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_Radius}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding CornerRadius}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0}px}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_HeaderHeight}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="HeaderSlider" Grid.Column="1" Minimum="34" Maximum="56" Value="{Binding HeaderHeight}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HeaderSlider, StringFormat={}{0:0}px}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <CheckBox Content="{DynamicResource Appearance_ShowIcon}" IsChecked="{Binding ShowCollapsedIcon}" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,4,0,4" /><CheckBox Content="{DynamicResource Appearance_ShowBadge}" IsChecked="{Binding ShowBadge}" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,0,0,4" /><CheckBox Content="{DynamicResource Quick_Startup}" IsChecked="{Binding IsChecked, ElementName=StartupCheck}" Checked="StartupAppearanceChanged" Unchecked="StartupAppearanceChanged" Margin="0,0,0,4" /><CheckBox Content="{DynamicResource Appearance_AttachDesktop}" IsChecked="{Binding AttachToDesktop}" Checked="AttachChanged" Unchecked="AttachChanged" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{DynamicResource Appearance_LanguageRegion}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_LanguageRegionHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Appearance_Language}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <DockPanel>
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="AppLanguageSelector" SelectedIndex="{Binding SelectedIndex, ElementName=LanguageSelector, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Appearance_Language}">
                                                    <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                                                    <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Appearance_RegionFormat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <DockPanel>
                                                <TextBlock Text="A" FontSize="19" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="RegionSelector" SelectionChanged="Region_Changed" AutomationProperties.Name="{DynamicResource Appearance_RegionFormat}">
                                                    <ComboBoxItem Content="{DynamicResource Appearance_FollowSystem}" Tag="system" />
                                                    <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                                                    <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel></Border>
                        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Padding="12" Margin="0,0,0,2"><DockPanel><Border Width="38" Height="38" Background="{DynamicResource ControlBrush}" CornerRadius="9" Margin="0,0,12,0"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Appearance_RuntimeTitle}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{DynamicResource Appearance_RuntimeDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="0,0,8,0"><TextBlock Text=".NET 10 LTS" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" /></Border><Border Background="#EAF8F2" CornerRadius="16" Padding="12,5" Margin="0,0,8,0"><TextBlock Text="x64" Foreground="#188253" FontSize="10" /></Border><Border Background="#EAF8F2" CornerRadius="16" Padding="12,5"><TextBlock Text="ARM64" Foreground="#188253" FontSize="10" /></Border></StackPanel></DockPanel></Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="QuickPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource Nav_Quick}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Quick_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                    <Button x:Name="ExpandAllButton" Height="116" Margin="0,0,8,0" Padding="16" HorizontalContentAlignment="Stretch" Click="ExpandAll_Click" AutomationProperties.AutomationId="ExpandAll"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="#7190BC" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_ExpandAll}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_ExpandAllDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                    <Button x:Name="CollapseAllButton" Height="116" Margin="4,0" Padding="16" HorizontalContentAlignment="Stretch" Click="CollapseAll_Click" AutomationProperties.AutomationId="CollapseAll"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="#7190BC" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_CollapseAll}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_CollapseAllDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                    <Button Height="116" Margin="8,0,0,0" Padding="16" HorizontalContentAlignment="Stretch" Click="OpenConfig_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Border Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="#7190BC" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_OpenConfig}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_OpenConfigDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                </UniformGrid>
                <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource Quick_StartupRecovery}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" /><Border Style="{StaticResource CardBorder}" Padding="14"><StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Style="{StaticResource MiniIconTile}"><TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Quick_Startup}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_StartupDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="StartupCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="StartupChanged" Unchecked="StartupChanged" VerticalAlignment="Center" /></Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Style="{StaticResource MiniIconTile}"><TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Quick_ExplorerRecovery}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_ExplorerRecoveryDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="ExplorerRestoreCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestoreAfterExplorerRestart}" Checked="RecoveryChanged" Unchecked="RecoveryChanged" VerticalAlignment="Center" /></Grid>
                </StackPanel></Border></StackPanel>
            </Grid>

            <Grid x:Name="AboutPage" Visibility="Collapsed" Margin="32,25,32,28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/MiniDesk-256.png" Width="94" Height="94" />
                    <TextBlock Text="MiniDesk" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource About_Tagline}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
                    <Border Width="34" Height="3" Background="#1769F7" CornerRadius="2" HorizontalAlignment="Center" Margin="0,14,0,22" />
                </StackPanel>
            </Grid>
        </Grid>
        <Border x:Name="ModalOverlay" Grid.ColumnSpan="2" Panel.ZIndex="900" Background="#720A1730" Visibility="Collapsed" IsHitTestVisible="True" />
    </Grid>
</Window>



