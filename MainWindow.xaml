<Window x:Class="MiniDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MiniDesk.Controls"
        Title="MiniDesk" Width="1180" Height="820" MinWidth="960" MinHeight="680" Language="{DynamicResource CurrentLanguage}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
    <DataTemplate x:Key="SoftGroupIcon">
        <ui:SoftBorder Style="{StaticResource GroupIconTile}" Width="24" Height="24" Depth="2">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemGroupIconContent}" Margin="3" />
        </ui:SoftBorder>
    </DataTemplate>

        <Style x:Key="FeatureCard" TargetType="ui:SoftBorder" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="14" /><Setter Property="MinHeight" Value="94" />
        </Style>
        <Style x:Key="MiniIconTile" TargetType="ui:SoftBorder">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="{DynamicResource CardBrush}" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="194" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ui:SoftBorder x:Name="SidebarShell" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Image x:Name="ApplicationBrandIcon" Source="/Assets/MiniDesk-256.png" Width="38" Height="38" Stretch="Uniform" AutomationProperties.Name="MiniDesk" />
                    <TextBlock Text="MiniDesk" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="HomeNav" Tag="Home" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Home}" /></StackPanel></Button>
                    <Button x:Name="GroupsNav" Tag="Groups" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA5;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Groups}" /></StackPanel></Button>
                    <Button x:Name="SnapshotsNav" Tag="Snapshots" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Snapshots}" /></StackPanel></Button>
                    <Button x:Name="AppearanceNav" Tag="Appearance" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Appearance}" /></StackPanel></Button>
                    <Button x:Name="QuickNav" Tag="Quick" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_Quick}" /></StackPanel></Button>
                    <Button x:Name="AboutNav" Tag="About" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="28" /><TextBlock Text="{DynamicResource Nav_About}" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="8,0,0,0"><TextBlock x:Name="PreviewHint" Text="{DynamicResource Preview_DesktopHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" /><TextBlock Text="{DynamicResource Sidebar_Line1}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /><TextBlock Text="{DynamicResource Sidebar_Line2}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
            </Grid>
        </ui:SoftBorder>

        <Grid x:Name="WorkspaceContent" Grid.Column="1">
            <Grid x:Name="HomePage" Margin="32,28">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid VerticalAlignment="Center" MaxWidth="760">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.32*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="27" FontWeight="SemiBold"><Run Text="{DynamicResource Home_Title}" /><Run Text="👋" FontFamily="Segoe UI Emoji" /></TextBlock><TextBlock Text="{DynamicResource Home_Subtitle}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,24" /><WrapPanel><Button x:Name="HomeOrganizeButton" Content="{DynamicResource Organize_Title}" MinHeight="46" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Click="Organize_Click" /><Button Content="{DynamicResource Home_Start}" MinHeight="46" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Click="GoGroups_Click" /></WrapPanel></StackPanel>
                    <Grid x:Name="HomeIllustration" Grid.Column="1" Width="250" Height="220" HorizontalAlignment="Right">
                        <ui:SoftBorder Width="142" Height="136" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,28" CornerRadius="24" Depth="8" Background="{DynamicResource CardBrush}" />
                        <ui:SoftBorder Width="160" Height="124" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,30,0,0" CornerRadius="24" Depth="8" Background="{DynamicResource CardBrush}">
                            <Grid Margin="24"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="46" HorizontalAlignment="Left" VerticalAlignment="Center" /><ui:SoftBorder Height="8" Width="38" Depth="-2" CornerRadius="12" Background="{DynamicResource CardBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
                        </ui:SoftBorder>
                    </Grid>
                </Grid>
                <UniformGrid Grid.Row="1" Columns="4" MaxWidth="760" Margin="0,34,0,0">
                    <ui:SoftBorder Style="{StaticResource FeatureCard}" Margin="0,0,8,0"><StackPanel><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="{DynamicResource CardBrush}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="{DynamicResource Home_Organize}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_OrganizeDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></ui:SoftBorder>
                    <ui:SoftBorder Style="{StaticResource FeatureCard}" Margin="4,0"><StackPanel><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="{DynamicResource CardBrush}"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="{DynamicResource Home_Collapse}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_CollapseDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></ui:SoftBorder>
                    <ui:SoftBorder Style="{StaticResource FeatureCard}" Margin="4,0"><StackPanel><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left" Background="{DynamicResource CardBrush}"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="{DynamicResource Nav_Snapshots}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_SnapshotDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></ui:SoftBorder>
                    <ui:SoftBorder Style="{StaticResource FeatureCard}" Margin="8,0,0,0"><StackPanel><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="{DynamicResource Home_Appearance}" FontWeight="SemiBold" FontSize="12" Margin="0,11,0,4" /><TextBlock Text="{DynamicResource Home_AppearanceDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel></ui:SoftBorder>
                </UniformGrid>
            </Grid>

            <Grid x:Name="GroupsPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Nav_Groups}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Groups_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel><WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,12"><Button x:Name="GroupUndoButton" ToolTip="{DynamicResource Organize_NoUndo}" Content="{DynamicResource Organize_Undo}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="UndoOrganization_Click"/><Button x:Name="GroupOrganizeButton" Content="{DynamicResource Organize_Title}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Organize_Click"/><Button x:Name="NewGroupButton" Content="{DynamicResource Groups_New}" Style="{StaticResource PrimaryButton}" MinHeight="38" Margin="0,0,0,8" Click="NewGroup_Click" AutomationProperties.AutomationId="NewGroup" /></WrapPanel></Grid>
                <ui:SoftBorder Grid.Row="1" Style="{StaticResource CardBorder}" CornerRadius="16" Background="{DynamicResource CardBrush}" Padding="14,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="78" /><ColumnDefinition Width="124" /><ColumnDefinition Width="76" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="{DynamicResource Groups_Name}" FontSize="10" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="2" Text="{DynamicResource Groups_Items}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="3" Text="{DynamicResource Groups_State}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="4" Text="{DynamicResource Groups_AutoCollapse}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="5" Text="{DynamicResource Groups_Actions}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /></Grid>
                </ui:SoftBorder>
                <ui:SoftBorder Grid.Row="2" Style="{StaticResource CardBorder}" CornerRadius="16" BorderThickness="0" Padding="8,2,8,8">
                    <ListBox x:Name="GroupList" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><ui:SoftBorder BorderBrush="#E8EEF6" BorderThickness="0" Padding="6,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="78" /><ColumnDefinition Width="124" /><ColumnDefinition Width="76" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions>
                            <ui:SoftBorder Style="{StaticResource GroupIconTile}" ToolTip="{Binding Name}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemGroupIconContent}" Margin="4" /></ui:SoftBorder>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding ItemCount}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ComboBox Grid.Column="3" SelectedIndex="{Binding StateIndex}" SelectionChanged="GroupState_Changed" Margin="4,0"><ComboBoxItem Content="{DynamicResource State_Expanded}" /><ComboBoxItem Content="{DynamicResource State_Collapsed}" /><ComboBoxItem Content="{DynamicResource State_IconOnly}" /></ComboBox>
                            <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" Checked="GroupEnabled_Changed" Unchecked="GroupEnabled_Changed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="82" Height="34" Padding="8,0" Margin="0,0,6,0" ToolTip="{DynamicResource Groups_Rename}" AutomationProperties.Name="{DynamicResource Groups_Rename}" Click="RenameGroup_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" /><TextBlock Text="{DynamicResource Groups_Rename}" Margin="6,0,0,0" /></StackPanel></Button><Button Width="70" Height="34" Padding="8,0" ToolTip="{DynamicResource Groups_Delete}" AutomationProperties.Name="{DynamicResource Groups_Delete}" Click="DeleteGroup_Click" Style="{StaticResource DangerButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" /><TextBlock Text="{DynamicResource Groups_Delete}" Margin="6,0,0,0" /></StackPanel></Button></StackPanel>
                        </Grid></ui:SoftBorder></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </ui:SoftBorder>
            </Grid>

            <Grid x:Name="SnapshotsPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="{DynamicResource Nav_Snapshots}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Snapshots_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel><Button x:Name="CreateSnapshotButton" Content="{DynamicResource Snapshots_Create}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="38" Click="CreateSnapshot_Click" AutomationProperties.AutomationId="CreateSnapshot" /></Grid>
                <ListBox x:Name="SnapshotList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,11" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><ui:SoftBorder Style="{StaticResource CardBorder}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SoftBorder Width="112" Height="66" CornerRadius="12" Background="{DynamicResource CardBrush}"><Image Source="/Assets/MiniDesk-256.png" Width="48" Height="48" Opacity="0.88" /></ui:SoftBorder>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" /><ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="6,2" Margin="9,0,0,0"><TextBlock Text="{DynamicResource Snapshots_Manual}" Foreground="{DynamicResource MutedBrush}" FontSize="9" /></ui:SoftBorder></StackPanel><TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6,0,0"><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:g}}" /><Run Text="{DynamicResource Snapshot_Contains}" /><Run Text="{Binding GroupCount, Mode=OneWay}" /><Run Text="{DynamicResource Snapshot_GroupsSuffix}" /></TextBlock></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource Snapshots_Restore}" Style="{StaticResource PrimaryButton}" Height="34" Click="RestoreSnapshot_Click" Margin="0,0,8,0" /><Button Content="···" Style="{StaticResource IconButton}" FontWeight="Bold" Click="SnapshotMore_Click"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource Snapshots_Preview}" Click="PreviewSnapshot_Click" /><Separator /><MenuItem Header="{DynamicResource Snapshots_Delete}" Foreground="{DynamicResource MutedBrush}" Click="DeleteSnapshot_Click" /></ContextMenu></Button.ContextMenu></Button></StackPanel>
                    </Grid></ui:SoftBorder></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="SnapshotEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <TextBlock Text="{DynamicResource Snapshots_Empty}" Foreground="{DynamicResource TextBrush}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Snapshots_EmptyHint}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,22" />
                    <Button Content="{DynamicResource Snapshots_Create}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="CreateSnapshot_Click" />
                </StackPanel>
            </Grid>

            <ui:SmoothScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,22,28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{DynamicResource Nav_Appearance}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Appearance_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" /></StackPanel>
                        <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="154" VerticalAlignment="Top" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Appearance_Language}">
                            <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                            <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ui:SoftBorder Style="{StaticResource SettingCard}" Margin="0,0,20,20">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_Theme}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_ThemeHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SystemTheme" Tag="System" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="0,0,5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_System}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_SystemDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="LightTheme" Tag="Light" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="2,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_Light}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_LightDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="DarkTheme" Tag="Dark" Checked="Theme_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="5,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="23" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource Theme_Dark}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource Theme_DarkDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </ui:SoftBorder>
                        <ui:SoftBorder Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,20">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Appearance_Preview}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_PreviewHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,2,0,0" /></StackPanel>
                                <ui:SoftBorder x:Name="PreviewScene" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Height="132" Background="{DynamicResource CardBrush}" CornerRadius="12" ClipToBounds="True">
                                    <Grid><ui:SoftBorder x:Name="PreviewSceneTint" Background="{DynamicResource CardBrush}" Opacity="0.55" CornerRadius="12" /><ui:SoftBorder x:Name="PreviewSceneAccent" Background="{DynamicResource CardBrush}" Width="210" Height="180" CornerRadius="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,-105" />
                                        <ui:SoftBorder x:Name="PreviewPanel" Background="Transparent" CornerRadius="16" BorderBrush="#AFFFFFFF" BorderThickness="0" Width="260" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <!-- Alpha and corner geometry are applied to the same background/card values as DesktopGroupWindow. -->
                                                <ui:SoftBorder x:Name="PreviewSurface" Background="{DynamicResource CardBrush}" CornerRadius="16" />
                                                <Grid x:Name="PreviewExpandedContents" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <DockPanel x:Name="PreviewExpandedHeader"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SoftBorder x:Name="PreviewExpandedIcon" Style="{StaticResource GroupIconTile}" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource CardBrush}" Margin="0,0,7,0"><Grid><TextBlock x:Name="PreviewExpandedGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewExpandedCustomIcon" Stretch="Uniform" Margin="2" /></Grid></ui:SoftBorder><TextBlock x:Name="PreviewExpandedName" Text="{DynamicResource Appearance_Development}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel><TextBlock Text="⌃" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
                                                    <Grid Grid.Row="1" Margin="0,6,0,0"><ItemsControl x:Name="PreviewItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center" Margin="2,0"><Image Source="{Binding Path, Converter={StaticResource ShellIcon}}" Width="28" Height="28" Stretch="Uniform" /><TextBlock Text="{Binding Name}" FontSize="8" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="PreviewItemsEmptyHint" Text="{DynamicResource Group_EmptyHint}" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
                                                </Grid>
                                                <Grid x:Name="PreviewCollapsedContent" Visibility="Collapsed" Margin="9"><Grid x:Name="PreviewCollapsedLayout">
                                                    <ui:SoftBorder x:Name="PreviewCollapsedIcon" Style="{StaticResource GroupIconTile}" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource CardBrush}"><Grid><TextBlock x:Name="PreviewCollapsedGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewCollapsedCustomIcon" Stretch="Uniform" Margin="4" /></Grid></ui:SoftBorder>
                                                    <TextBlock x:Name="PreviewCollapsedName" Grid.Column="1" Text="{DynamicResource Appearance_Development}" FontWeight="SemiBold" FontSize="14" Margin="11,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <ui:SoftBorder x:Name="PreviewCollapsedBadge" Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="PreviewCollapsedCount" Text="0" Foreground="{DynamicResource MutedBrush}" FontSize="11" /></ui:SoftBorder>
                                                </Grid></Grid>
                                                <ui:SoftBorder x:Name="PreviewIconOnlyContent" Visibility="Collapsed" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"><ui:SoftBorder x:Name="PreviewOnlyIcon" Style="{StaticResource GroupIconTile}" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource CardBrush}"><Grid><TextBlock x:Name="PreviewOnlyGlyph" Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="PreviewOnlyCustomIcon" Stretch="Uniform" Margin="4" /></Grid></ui:SoftBorder></ui:SoftBorder>
                                            </Grid>
                                        </ui:SoftBorder>
                                    </Grid>
                                </ui:SoftBorder>
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,10,0,0" VerticalAlignment="Center"><Button x:Name="PreviewExpandedButton" Content="{DynamicResource Preview_Expanded}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="PreviewExpanded_Click" /><Button x:Name="PreviewCollapsedButton" Content="{DynamicResource Preview_Collapsed}" Margin="0,0,0,6" Click="PreviewCollapsed_Click" /><Button x:Name="PreviewIconOnlyButton" Content="{DynamicResource Preview_IconOnly}" Click="PreviewIconOnly_Click" /></StackPanel>
                            </Grid>
                        </ui:SoftBorder>
                        <ui:SoftBorder Grid.Row="1" Style="{StaticResource SettingCard}" Margin="0,0,20,20">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_CollapseStyle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_CollapseHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="CapsuleStyle" Tag="HorizontalCapsule" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Collapse_Capsule}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="60" Height="62">
                                                <ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="12" Depth="-2" Height="36" Padding="6" VerticalAlignment="Center">
                                                    <Grid><ContentControl x:Name="CapsuleStyleIcon" ContentTemplate="{StaticResource SoftGroupIcon}" HorizontalAlignment="Left" VerticalAlignment="Center" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"><Border Width="20" Height="3" CornerRadius="1.5" Background="{DynamicResource MutedBrush}" /><Border Width="13" Height="3" CornerRadius="1.5" Background="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="0,4,0,0" Opacity="0.5" /></StackPanel></Grid>
                                                </ui:SoftBorder>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Collapse_Capsule}" Foreground="{DynamicResource TextBrush}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="VerticalStyle" Tag="VerticalIcon" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="3,0" AutomationProperties.Name="{DynamicResource Collapse_Vertical}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="60" Height="62">
                                                <ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="12" Depth="-2" Width="38" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ContentControl x:Name="VerticalStyleIcon" ContentTemplate="{StaticResource SoftGroupIcon}" HorizontalAlignment="Center" /><Border Width="20" Height="3" CornerRadius="1.5" Background="{DynamicResource MutedBrush}" Margin="0,7,0,0" /><Border Width="12" Height="3" CornerRadius="1.5" Background="{DynamicResource MutedBrush}" Margin="0,4,0,0" Opacity="0.5" /></StackPanel>
                                                </ui:SoftBorder>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Collapse_Vertical}" Foreground="{DynamicResource TextBrush}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="IconStyle" Tag="IconOnly" Checked="CollapseStyle_Checked" Style="{StaticResource ChoiceCardRadio}" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource Collapse_IconOnly}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="60" Height="62">
                                                <ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="12" Depth="-2" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentControl x:Name="IconOnlyStyleIcon" ContentTemplate="{StaticResource SoftGroupIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Collapse_IconOnly}" Foreground="{DynamicResource TextBrush}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </ui:SoftBorder>
                        <ui:SoftBorder Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,20">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Appearance_Monitors}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_MonitorsHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,8,0" /></StackPanel><Button x:Name="RefreshMonitorsButton" Grid.Column="1" Content="{DynamicResource Appearance_DetectMonitors}" Click="RefreshMonitors_Click" Padding="8,5" /></Grid>
                                <ItemsControl x:Name="MonitorList" Grid.Row="1" Margin="0,8,0,7"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ui:SoftBorder Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="12" Padding="8"><StackPanel><Grid Height="52" Background="{DynamicResource CardBrush}" ClipToBounds="True"><ui:SoftBorder Background="{DynamicResource CardBrush}" Opacity="0.65" CornerRadius="12" /><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"><Run Text="{Binding WorkArea.Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding WorkArea.Height, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ScalePercent, Mode=OneWay}" /><Run Text="%" /></TextBlock><TextBlock Text="{Binding PrimaryLabel, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /></StackPanel></ui:SoftBorder></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <WrapPanel Grid.Row="2"><CheckBox Content="{DynamicResource Appearance_RememberMonitorLayout}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,12,4" /><CheckBox Content="{DynamicResource Appearance_MoveToPrimary}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,12,4" /><CheckBox Content="{DynamicResource Appearance_RestoreOnReconnect}" IsChecked="True" IsHitTestVisible="False" Margin="0,0,0,4" /></WrapPanel>
                            </Grid>
                        </ui:SoftBorder>
                        <ui:SoftBorder Grid.Row="2" Style="{StaticResource SettingCard}" Margin="0,0,20,20">
                            <StackPanel><TextBlock Text="{DynamicResource Appearance_Parameters}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_ParametersHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,8" />
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_Opacity}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding PanelOpacity}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_Radius}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding CornerRadius}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0}px}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Appearance_HeaderHeight}" FontSize="10" VerticalAlignment="Center" /><Slider x:Name="HeaderSlider" Grid.Column="1" Minimum="34" Maximum="56" Value="{Binding HeaderHeight}" ValueChanged="Appearance_Changed" /><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HeaderSlider, StringFormat={}{0:0}px}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                <CheckBox Content="{DynamicResource Appearance_ShowIcon}" IsChecked="{Binding ShowCollapsedIcon}" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,4,0,4" /><CheckBox Content="{DynamicResource Appearance_ShowBadge}" IsChecked="{Binding ShowBadge}" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,0,0,4" /><CheckBox Content="{DynamicResource Quick_Startup}" IsChecked="{Binding IsChecked, ElementName=StartupCheck}" Checked="StartupAppearanceChanged" Unchecked="StartupAppearanceChanged" Margin="0,0,0,4" /><CheckBox Content="{DynamicResource Appearance_AttachDesktop}" IsChecked="{Binding AttachToDesktop}" Checked="AttachChanged" Unchecked="AttachChanged" />
                            </StackPanel>
                        </ui:SoftBorder>
                        <ui:SoftBorder Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,20"><StackPanel><TextBlock Text="{DynamicResource Appearance_LanguageRegion}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource Appearance_LanguageRegionHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SoftBorder Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="12" Padding="8" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Appearance_Language}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <DockPanel>
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="AppLanguageSelector" SelectedIndex="{Binding SelectedIndex, ElementName=LanguageSelector, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Appearance_Language}">
                                                    <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                                                    <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </ui:SoftBorder>
                                    <ui:SoftBorder Grid.Column="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="12" Padding="8" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Appearance_RegionFormat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <DockPanel>
                                                <TextBlock Text="A" FontSize="19" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="RegionSelector" SelectionChanged="Region_Changed" AutomationProperties.Name="{DynamicResource Appearance_RegionFormat}">
                                                    <ComboBoxItem Content="{DynamicResource Appearance_FollowSystem}" Tag="system" />
                                                    <ComboBoxItem Content="{DynamicResource Language_ZhCN}" Tag="zh-CN" />
                                                    <ComboBoxItem Content="{DynamicResource Language_EnUS}" Tag="en-US" />
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </ui:SoftBorder>
                                </Grid>
                            </StackPanel></ui:SoftBorder>
                        <ui:SoftBorder Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Padding="12" Margin="0,0,0,2"><DockPanel><ui:SoftBorder Width="38" Height="38" Background="{DynamicResource ControlBrush}" CornerRadius="12" Margin="0,0,12,0"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Appearance_RuntimeTitle}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{DynamicResource Appearance_RuntimeDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><ui:SoftBorder Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="16" Padding="12,5" Margin="0,0,8,0"><TextBlock Text=".NET 10 LTS" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" /></ui:SoftBorder><ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="12,5" Margin="0,0,8,0"><TextBlock Text="x64" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></ui:SoftBorder><ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="12,5"><TextBlock Text="ARM64" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></ui:SoftBorder></StackPanel></DockPanel></ui:SoftBorder>
                    </Grid>
                </Grid>
            </ui:SmoothScrollViewer>

            <Grid x:Name="QuickPage" Visibility="Collapsed" Margin="32,25,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource Nav_Quick}" Style="{StaticResource PageTitle}" /><TextBlock Text="{DynamicResource Quick_Subtitle}" Style="{StaticResource PageSubtitle}" /></StackPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                    <Button x:Name="ExpandAllButton" Height="116" Margin="0,0,8,0" Padding="16" HorizontalContentAlignment="Stretch" Click="ExpandAll_Click" AutomationProperties.AutomationId="ExpandAll"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="{DynamicResource MutedBrush}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_ExpandAll}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_ExpandAllDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                    <Button x:Name="CollapseAllButton" Height="116" Margin="4,0" Padding="16" HorizontalContentAlignment="Stretch" Click="CollapseAll_Click" AutomationProperties.AutomationId="CollapseAll"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="{DynamicResource MutedBrush}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_CollapseAll}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_CollapseAllDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                    <Button Height="116" Margin="8,0,0,0" Padding="16" HorizontalContentAlignment="Stretch" Click="OpenConfig_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><ui:SoftBorder Style="{StaticResource MiniIconTile}" HorizontalAlignment="Left"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><TextBlock Text="›" HorizontalAlignment="Right" FontSize="24" Foreground="{DynamicResource MutedBrush}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Quick_OpenConfig}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_OpenConfigDesc}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid></Button>
                </UniformGrid>
                <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource Quick_StartupRecovery}" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" /><ui:SoftBorder Style="{StaticResource CardBorder}" Padding="14"><StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SoftBorder Style="{StaticResource MiniIconTile}"><TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Quick_Startup}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_StartupDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="StartupCheck" AutomationProperties.Name="{DynamicResource Quick_Startup}" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="StartupChanged" Unchecked="StartupChanged" VerticalAlignment="Center" /></Grid>
                    <ui:SoftBorder Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SoftBorder Style="{StaticResource MiniIconTile}"><TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:SoftBorder><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Quick_ExplorerRecovery}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Quick_ExplorerRecoveryDesc}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="ExplorerRestoreCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestoreAfterExplorerRestart}" Checked="RecoveryChanged" Unchecked="RecoveryChanged" VerticalAlignment="Center" /></Grid>
                </StackPanel></ui:SoftBorder></StackPanel>
            </Grid>

            <Grid x:Name="AboutPage" Visibility="Collapsed" Margin="32,25,32,28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/MiniDesk-256.png" Width="94" Height="94" />
                    <TextBlock Text="MiniDesk" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource About_Tagline}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
                    <ui:SoftBorder Width="34" Height="3" Background="{DynamicResource CardBrush}" CornerRadius="12" HorizontalAlignment="Center" Margin="0,14,0,22" />
                </StackPanel>
            </Grid>
        </Grid>
        <ui:SoftBorder x:Name="OperationNotice" Grid.Column="1" Panel.ZIndex="800" Style="{StaticResource ToastCard}" MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,18" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="4,0,12,0" />
                <TextBlock x:Name="OperationStatus" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="2" Content="×" Style="{StaticResource IconButton}" Click="DismissNotice_Click" Margin="16,0,0,0" AutomationProperties.Name="{DynamicResource Common_Close}" />
            </Grid>
        </ui:SoftBorder>
        <Grid x:Name="CreateGroupLayer" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="Hidden" IsHitTestVisible="False" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
            <Border x:Name="CreateGroupBackdrop" Background="#18333B4B" MouseLeftButtonDown="GroupBackdrop_Click" />
            <ui:SoftBorder x:Name="GroupPanelSurface" Width="560" Height="650" MaxHeight="720" CornerRadius="20" Background="{DynamicResource CardBrush}" Depth="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" RenderTransformOrigin="0.5,0.5">
                <ui:SoftBorder.RenderTransform><ScaleTransform x:Name="GroupPanelScale" ScaleX="1" ScaleY="1" /></ui:SoftBorder.RenderTransform>
                <ui:CreateGroupPanel x:Name="GroupEditor" />
            </ui:SoftBorder>
        </Grid>
        <Border x:Name="ModalOverlay" Grid.ColumnSpan="2" Panel.ZIndex="900" Background="#18333B4B" Visibility="Collapsed" IsHitTestVisible="True" />
    </Grid>
</Window>
