<Window x:Class="MiniDesk.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MiniDesk.Controls"
        Title="{DynamicResource Create_Title}" Width="690" Height="850" ResizeMode="NoResize" Language="{DynamicResource CurrentLanguage}"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource CardBrush}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="FlatTabButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
        <Style x:Key="FluentComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
        <Style x:Key="FluentCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}" />
        <Style x:Key="IconChoiceStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="84" /><Setter Property="Height" Value="94" /><Setter Property="Margin" Value="0,0,9,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <ui:SoftBorder x:Name="ChoiceBorder" Background="{DynamicResource CardBrush}" CornerRadius="16" Depth="4" Padding="7" Cursor="Hand"><ContentPresenter /></ui:SoftBorder>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="Depth" Value="2" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceBorder" Property="Depth" Value="-4" /><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="1" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <ui:SoftBorder Depth="0" Margin="0" Background="{DynamicResource CardBrush}" BorderBrush="#DFE6F0" BorderThickness="0" CornerRadius="16">

        <Grid Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="220" />
                <RowDefinition Height="18" />
                <RowDefinition Height="1" />
                <RowDefinition Height="20" />
                <RowDefinition Height="168" />
                <RowDefinition Height="20" />
                <RowDefinition Height="1" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="DialogHeading" Text="{DynamicResource Create_Title}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogSubtitle" Text="{DynamicResource Create_Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34"
                        Background="Transparent" BorderThickness="0" Padding="0" Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource MutedBrush}" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Groups_Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="GroupNameBox" Height="48" FontSize="14" Padding="13,0" BorderBrush="#C9D5E5"
                             TextChanged="GroupNameBox_TextChanged" AutomationProperties.AutomationId="GroupName" />
                    <TextBlock x:Name="NamePlaceholder" Text="{DynamicResource Create_NamePlaceholder}" Foreground="{DynamicResource MutedBrush}"
                               Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="4">
                <TextBlock Text="{DynamicResource Create_SelectIcon}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,11" />
                <ui:SoftBorder Height="48" Background="{DynamicResource CardBrush}" BorderBrush="#DFE7F1" BorderThickness="0" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:SoftBorder x:Name="SystemTabIndicator" Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="1"
                                BorderBrush="#D7E1EF" BorderThickness="0" />
                        <ui:SoftBorder x:Name="UploadTabIndicator" Grid.Column="1" Background="Transparent" CornerRadius="12" Margin="1" />
                        <Button x:Name="SystemTabButton" Grid.Column="0" Style="{StaticResource FlatTabButton}" Click="SystemTab_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="17" /><TextBlock Text="{DynamicResource Create_SystemIcons}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="9,0,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="UploadTabButton" Grid.Column="1" Style="{StaticResource FlatTabButton}" Click="UploadTab_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="17" /><TextBlock Text="{DynamicResource Create_UploadIcon}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="9,0,0,0" /></StackPanel>
                        </Button>
                    </Grid>
                </ui:SoftBorder>
            </StackPanel>

            <Grid Grid.Row="6">
                <ListBox x:Name="IconChoices" Background="Transparent" BorderThickness="0" SelectionChanged="IconChoices_SelectionChanged"
                         ItemContainerStyle="{StaticResource IconChoiceStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SoftBorder Width="52" Height="52" CornerRadius="13" Depth="3" Background="{DynamicResource CardBrush}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemGroupIconContent}" Margin="7" />
                                </ui:SoftBorder>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:SoftBorder x:Name="UploadPanel" Visibility="Collapsed" Background="{DynamicResource CardBrush}" BorderBrush="#C9D7E8" BorderThickness="0"
                        CornerRadius="12" AllowDrop="True" DragOver="UploadPanel_DragOver" Drop="UploadPanel_Drop">
                    <Grid Margin="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="152" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:SoftBorder Background="{DynamicResource CardBrush}" BorderBrush="#DCE5F0" BorderThickness="0" CornerRadius="12" Padding="10">
                            <Grid>
                                <TextBlock x:Name="UploadEmptyGlyph" Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="UploadPreviewImage" Stretch="Uniform" Margin="8" />
                            </Grid>
                        </ui:SoftBorder>
                        <StackPanel Grid.Column="1" Margin="24,8,0,0">
                            <TextBlock Text="{DynamicResource Create_UploadTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Create_UploadFormats}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Create_UploadDrop}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,14" />
                            <Button x:Name="ChooseIconButton" Content="{DynamicResource Create_ChooseFile}" Width="112" HorizontalAlignment="Left" Click="ChooseIcon_Click" />
                            <TextBlock x:Name="UploadFileName" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0" />
                            <TextBlock x:Name="UploadError" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:SoftBorder>
            </Grid>

            <ui:SoftBorder Grid.Row="8" Background="{DynamicResource CardBrush}" />

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="302" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ui:SoftBorder Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Appearance_Preview}" FontWeight="SemiBold" FontSize="13" />
                        <ui:SoftBorder Width="192" Height="66" HorizontalAlignment="Center" Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,12,0,0">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SoftBorder Width="48" Height="48" CornerRadius="12" Depth="3" Background="{DynamicResource CardBrush}">
                                    <Grid>
                                        <TextBlock x:Name="PreviewGlyph" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="#F54474" />
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" />
                                    </Grid>
                                </ui:SoftBorder>
                                <TextBlock x:Name="PreviewName" Text="{DynamicResource Default_Music}" FontWeight="SemiBold" FontSize="14" Margin="12,0,0,0" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ui:SoftBorder>
                        <TextBlock Text="{DynamicResource Create_PreviewHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </ui:SoftBorder>

                <StackPanel x:Name="StateSettings" Grid.Column="2">
                    <TextBlock Text="{DynamicResource Create_DefaultState}" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox x:Name="DefaultStateCombo" Height="46" Margin="0,10,0,0" SelectedIndex="0" SelectionChanged="DefaultStateCombo_SelectionChanged"
                              Style="{StaticResource FluentComboBox}">
                        <ComboBoxItem Content="{DynamicResource State_Expanded}" Tag="Expanded" />
                        <ComboBoxItem Content="{DynamicResource State_Collapsed}" Tag="Collapsed" />
                        <ComboBoxItem Content="{DynamicResource State_IconOnly}" Tag="IconOnly" />
                    </ComboBox>
                    <CheckBox x:Name="ShowOnDesktopCheck" Content="{DynamicResource Create_ShowDesktop}" IsChecked="True" FontSize="13" Margin="0,20,0,0"
                              Style="{StaticResource FluentCheckBox}" />
                    <TextBlock Text="{DynamicResource Create_ShowDesktopHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,7,0,0" />
                </StackPanel>
            </Grid>

            <ui:SoftBorder Grid.Row="12" Background="{DynamicResource CardBrush}" />

            <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}" Width="132" Height="48" Click="Cancel_Click" AutomationProperties.AutomationId="CancelCreateGroup" />
                <Button x:Name="CreateButton" Content="{DynamicResource Create_Action}" Width="132" Height="48" Margin="14,0,0,0"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Create_Click" AutomationProperties.AutomationId="ConfirmCreateGroup" />
            </StackPanel>
        </Grid>
    </ui:SoftBorder>
</Window>
