<Window x:Class="MiniDesk.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Create_Title}" Width="690" Height="850" ResizeMode="NoResize" Language="{DynamicResource CurrentLanguage}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Foreground="#14213D">
    <Window.Resources>
        <Style x:Key="FlatTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabRoot" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabRoot" Property="Background" Value="#F1F6FE" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconChoiceStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="94" />
            <Setter Property="Margin" Value="0,0,9,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChoiceBorder" Background="#FCFDFF" BorderBrush="#E2EAF4" BorderThickness="1"
                                CornerRadius="11" Padding="7" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#1769F7" />
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#F7FAFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="Background" Value="#F4F8FE" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#EAF2FE" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#DCEAFE" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FluentComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="14,0,42,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" />
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="#607089" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#C9D5E5" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.16" /></Border.Effect>
                                    <ScrollViewer MaxHeight="190"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="CheckRoot" Width="20" Height="20" CornerRadius="4" Background="White"
                                    BorderBrush="#AAB8CA" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckGlyph" Text="" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckRoot" Property="Background" Value="#1769F7" />
                                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#1769F7" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="#FFFEFE" BorderBrush="#DFE6F0" BorderThickness="1" CornerRadius="16">
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#193052" /></Border.Effect>
        <Grid Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="220" />
                <RowDefinition Height="18" />
                <RowDefinition Height="1" />
                <RowDefinition Height="20" />
                <RowDefinition Height="168" />
                <RowDefinition Height="20" />
                <RowDefinition Height="1" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Create_Title}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Create_Subtitle}" Foreground="#7A879E" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34"
                        Background="Transparent" BorderThickness="0" Padding="0" Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#66758D" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Groups_Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="GroupNameBox" Height="48" FontSize="14" Padding="13,0" BorderBrush="#C9D5E5"
                             TextChanged="GroupNameBox_TextChanged" AutomationProperties.AutomationId="GroupName" />
                    <TextBlock x:Name="NamePlaceholder" Text="{DynamicResource Create_NamePlaceholder}" Foreground="#94A0B4"
                               Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="4">
                <TextBlock Text="{DynamicResource Create_SelectIcon}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,11" />
                <Border Height="48" Background="#F4F7FB" BorderBrush="#DFE7F1" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="SystemTabIndicator" Grid.Column="0" Background="White" CornerRadius="9" Margin="1"
                                BorderBrush="#D7E1EF" BorderThickness="0,0,0,1" />
                        <Border x:Name="UploadTabIndicator" Grid.Column="1" Background="Transparent" CornerRadius="9" Margin="1" />
                        <Button x:Name="SystemTabButton" Grid.Column="0" Style="{StaticResource FlatTabButton}" Click="SystemTab_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="#1769F7" FontSize="17" /><TextBlock Text="{DynamicResource Create_SystemIcons}" Foreground="#1769F7" FontWeight="SemiBold" Margin="9,0,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="UploadTabButton" Grid.Column="1" Style="{StaticResource FlatTabButton}" Click="UploadTab_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="#526681" FontSize="17" /><TextBlock Text="{DynamicResource Create_UploadIcon}" Foreground="#526681" FontWeight="SemiBold" Margin="9,0,0,0" /></StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="6">
                <ListBox x:Name="IconChoices" Background="Transparent" BorderThickness="0" SelectionChanged="IconChoices_SelectionChanged"
                         ItemContainerStyle="{StaticResource IconChoiceStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="13" Background="{Binding Accent, Converter={StaticResource HexBrush}}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="UploadPanel" Visibility="Collapsed" Background="#F8FAFD" BorderBrush="#C9D7E8" BorderThickness="1"
                        CornerRadius="12" AllowDrop="True" DragOver="UploadPanel_DragOver" Drop="UploadPanel_Drop">
                    <Grid Margin="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="152" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="12" Padding="10">
                            <Grid>
                                <TextBlock x:Name="UploadEmptyGlyph" Text="" FontFamily="Segoe Fluent Icons" Foreground="#8BA0BD" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="UploadPreviewImage" Stretch="Uniform" Margin="8" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,8,0,0">
                            <TextBlock Text="{DynamicResource Create_UploadTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Create_UploadFormats}" Foreground="#7C899E" FontSize="12" Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Create_UploadDrop}" Foreground="#94A0B2" FontSize="11" Margin="0,4,0,14" />
                            <Button x:Name="ChooseIconButton" Content="{DynamicResource Create_ChooseFile}" Width="112" HorizontalAlignment="Left" Click="ChooseIcon_Click" />
                            <TextBlock x:Name="UploadFileName" TextTrimming="CharacterEllipsis" Foreground="#526681" FontSize="11" Margin="0,10,0,0" />
                            <TextBlock x:Name="UploadError" Foreground="#D13A50" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="8" Background="#E4EAF2" />

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="302" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F3F7FC" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Appearance_Preview}" FontWeight="SemiBold" FontSize="13" />
                        <Border Width="192" Height="66" HorizontalAlignment="Center" Background="White" CornerRadius="12" Margin="0,12,0,0">
                            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.10" /></Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="12" Background="{Binding ElementName=PreviewGlyph, Path=Tag, Converter={StaticResource HexBrush}}">
                                    <Grid>
                                        <TextBlock x:Name="PreviewGlyph" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="#F54474" />
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PreviewName" Text="{DynamicResource Default_Music}" FontWeight="SemiBold" FontSize="14" Margin="12,0,0,0" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Create_PreviewHint}" Foreground="#94A0B2" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Create_DefaultState}" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox x:Name="DefaultStateCombo" Height="46" Margin="0,10,0,0" SelectedIndex="0" SelectionChanged="DefaultStateCombo_SelectionChanged"
                              Style="{StaticResource FluentComboBox}">
                        <ComboBoxItem Content="{DynamicResource State_Expanded}" Tag="Expanded" />
                        <ComboBoxItem Content="{DynamicResource State_Collapsed}" Tag="Collapsed" />
                        <ComboBoxItem Content="{DynamicResource State_IconOnly}" Tag="IconOnly" />
                    </ComboBox>
                    <CheckBox x:Name="ShowOnDesktopCheck" Content="{DynamicResource Create_ShowDesktop}" IsChecked="True" FontSize="13" Margin="0,20,0,0"
                              Style="{StaticResource FluentCheckBox}" />
                    <TextBlock Text="{DynamicResource Create_ShowDesktopHint}" Foreground="#94A0B2" FontSize="11" Margin="24,7,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="12" Background="#E4EAF2" />

            <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}" Width="132" Height="48" Click="Cancel_Click" AutomationProperties.AutomationId="CancelCreateGroup" />
                <Button x:Name="CreateButton" Content="{DynamicResource Create_Action}" Width="132" Height="48" Margin="14,0,0,0"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Create_Click" AutomationProperties.AutomationId="ConfirmCreateGroup" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

