<Window x:Class="MiniDesk.OrganizeDesktopWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MiniDesk.Controls"
 Title="{DynamicResource Organize_Title}" Width="780" Height="640" MinWidth="540" MinHeight="400"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="{DynamicResource CurrentLanguage}"
 Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{DynamicResource Organize_Title}" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{DynamicResource Organize_Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
   <TextBlock Text="{DynamicResource Organize_Hint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
  <ui:SoftBorder Grid.Row="1" Style="{StaticResource CardBorder}">
   <Grid><ListBox x:Name="Items" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="{Binding Icon}" Width="32" Height="32"/>
      <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center"><TextBlock Text="{Binding Candidate.Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Candidate.Path}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Candidate.Path}"/></StackPanel>
      <ComboBox Grid.Column="2" MinWidth="170" MaxWidth="260" ItemsSource="{Binding Targets}" SelectedItem="{Binding Candidate.Target, Mode=TwoWay}" SelectionChanged="TargetChanged" AutomationProperties.Name="{DynamicResource Organize_Target}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox><TextBlock x:Name="EmptyHint" Text="{DynamicResource Organize_Empty}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
  </ui:SoftBorder>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Summary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
    <Button x:Name="ApplyButton" Content="{DynamicResource Organize_Apply}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
