<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic palette. AppThemeService swaps these brushes at runtime. -->
    <Color x:Key="ColorPrimary">#1769F7</Color>
    <Color x:Key="ColorSuccess">#18A66A</Color>
    <Color x:Key="ColorWarning">#ED9A18</Color>
    <Color x:Key="ColorDanger">#D9384E</Color>
    <Color x:Key="ColorBackground">#F7FAFE</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#DEE7F2</Color>
    <Color x:Key="ColorTextPrimary">#13213D</Color>
    <Color x:Key="ColorTextSecondary">#66728A</Color>
    <Color x:Key="ColorDisabled">#AAB6C7</Color>
    <Color x:Key="ColorLightHover">#E5EFFD</Color>
    <Color x:Key="ColorDarkSurface">#292E39</Color>
    <sys:Boolean x:Key="IsDarkTheme" xmlns:sys="clr-namespace:System;assembly=mscorlib">False</sys:Boolean>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F5FC" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="ControlBrush" Color="#EEF4FD" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#DBE9FD" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource ColorDisabled}" />

    <!-- Spacing scale: 4 / 8 / 12 / 16 / 24 / 32 DIPs -->
    <sys:Double x:Key="Space4" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
    <sys:Double x:Key="Space8" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="Space12" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="Space16" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="Space24" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="Space32" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <Thickness x:Key="PagePadding">32,26,32,28</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <sys:Double x:Key="TypeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
    <sys:Double x:Key="TypeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="TypeSubtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="TypeSection" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="TypeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
</ResourceDictionary>
