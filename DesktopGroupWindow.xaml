<Window x:Class="MiniDesk.DesktopGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False" Language="{DynamicResource CurrentLanguage}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Border x:Name="ExpandedCard" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="16"
                Background="#CCF5F9FF" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Background="#10FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" Margin="10,0,9,0" CornerRadius="8"
                            Background="{Binding Accent, Converter={StaticResource HexBrush}}">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="White"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconPath, Converter={StaticResource GroupIcon}}" Stretch="Uniform" Margin="3" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Background="#130C315F" CornerRadius="10" Padding="7,2" VerticalAlignment="Center" Margin="4,0,8,0">
                        <TextBlock Text="{Binding ItemCount}" Foreground="#566681" FontSize="11" />
                    </Border>
                    <Button Grid.Column="3" x:Name="CollapseButton" Content="{DynamicResource Group_Collapse}" FontSize="10"
                            Width="42" Height="30" Padding="0" Margin="0,0,8,0" Click="Collapse_Click" />
                </Grid>
                <ItemsControl x:Name="Items" Grid.Row="1" ItemsSource="{Binding Items}" Margin="8,4,8,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Width" Value="82" />
                            <Setter Property="Height" Value="86" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemCard" CornerRadius="9" Background="Transparent" Padding="5"
                                    MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove"
                                    MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu><MenuItem Header="{DynamicResource Group_RemoveItem}" Click="RemoveItem_Click" /></ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#8A9CB8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Path, Converter={StaticResource ShellIcon}}" Width="44" Height="44" Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" MaxHeight="30" ToolTip="{Binding Path}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemCard" Property="Background" Value="#1A1769F7" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="{DynamicResource Group_EmptyHint}"
                           Foreground="#71809A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <primitives:Thumb x:Name="ResizeThumb" Grid.Row="1" Width="18" Height="18" HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
                                  Background="Transparent">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="#7487A4" FontSize="12" />
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
        </Border>

        <Border x:Name="CollapsedCard" Visibility="Collapsed" BorderBrush="#BFFFFFFF" BorderThickness="1"
                CornerRadius="16" Background="#DCF6FAFF" Cursor="SizeAll"
                MouseLeftButtonDown="CollapsedCard_MouseLeftButtonDown" MouseMove="CollapsedCard_MouseMove"
                MouseLeftButtonUp="CollapsedCard_MouseLeftButtonUp">
            <Grid x:Name="CollapsedLayout" Margin="9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="CollapsedIcon" Width="38" Height="38" CornerRadius="10"
                        Background="{Binding Accent, Converter={StaticResource HexBrush}}">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding IconPath, Converter={StaticResource GroupIcon}}" Stretch="Uniform" Margin="4" />
                    </Grid>
                </Border>
                <TextBlock x:Name="CollapsedName" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                           Margin="11,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border x:Name="CollapsedBadge" Grid.Column="2" Background="#130C315F" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCount}" Foreground="#566681" FontSize="11" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

