<Window x:Class="MiniDesk.DesktopGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MiniDesk.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False" Language="{DynamicResource CurrentLanguage}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <ui:SoftBorder x:Name="ExpandedCard" BorderBrush="#AFFFFFFF" BorderThickness="0" CornerRadius="16"
                Background="{DynamicResource CardBrush}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Background="{DynamicResource CardBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SoftBorder Width="30" Height="30" Margin="10,0,9,0" CornerRadius="12"
                            Style="{StaticResource GroupIconTile}" Background="{DynamicResource CardBrush}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemGroupIconContent}" Margin="3" />
                    </ui:SoftBorder>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ui:SoftBorder Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="7,2" VerticalAlignment="Center" Margin="4,0,8,0">
                        <TextBlock Text="{Binding ItemCount}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </ui:SoftBorder>
                    <Button Grid.Column="3" x:Name="CollapseButton" Content="{DynamicResource Group_Collapse}" FontSize="10"
                            Width="42" Height="30" Padding="0" Margin="0,0,8,0" Click="Collapse_Click" />
                </Grid>
                <ItemsControl x:Name="Items" Grid.Row="1" ItemsSource="{Binding Items}" Margin="8,4,8,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Width" Value="82" />
                            <Setter Property="Height" Value="86" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:SoftBorder x:Name="ItemCard" CornerRadius="12" Background="Transparent" Padding="5"
                                    MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove"
                                    MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                <ui:SoftBorder.ContextMenu>
                                    <ContextMenu Opened="ItemContextMenu_Opened" />
                                </ui:SoftBorder.ContextMenu>
                                <StackPanel>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Path, Converter={StaticResource ShellIcon}}" Width="44" Height="44" Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" MaxHeight="30" ToolTip="{Binding Path}" />
                                </StackPanel>
                            </ui:SoftBorder>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemCard" Property="Background" Value="#1A1769F7" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="{DynamicResource Group_EmptyHint}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <primitives:Thumb x:Name="ResizeThumb" Grid.Row="1" Width="18" Height="18" HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
                                  Background="Transparent">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
        </ui:SoftBorder>

        <ui:SoftBorder x:Name="CollapsedCard" Visibility="Collapsed" BorderBrush="#BFFFFFFF" BorderThickness="0"
                CornerRadius="16" Background="{DynamicResource CardBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="CollapsedCard_MouseLeftButtonDown" MouseMove="CollapsedCard_MouseMove"
                MouseLeftButtonUp="CollapsedCard_MouseLeftButtonUp">
            <Grid x:Name="CollapsedLayout" Margin="9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:SoftBorder x:Name="CollapsedIcon" Width="38" Height="38" CornerRadius="12"
                        Style="{StaticResource GroupIconTile}" Background="{DynamicResource CardBrush}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SystemGroupIconContent}" Margin="3" />
                </ui:SoftBorder>
                <TextBlock x:Name="CollapsedName" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                           Margin="11,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ui:SoftBorder x:Name="CollapsedBadge" Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCount}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </ui:SoftBorder>
            </Grid>
        </ui:SoftBorder>
    </Grid>
</Window>
