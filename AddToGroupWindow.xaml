<Window x:Class="MiniDesk.AddToGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Add_Title}" Width="460" Height="560" MinHeight="430" Language="{DynamicResource CurrentLanguage}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Add_Title}" FontSize="24" FontWeight="SemiBold" />
        <Border Grid.Row="1" Background="#EAF3FF" BorderBrush="#CFE2FF" BorderThickness="1"
                CornerRadius="12" Padding="12" Margin="0,14,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image x:Name="FileIcon" Width="42" Height="42" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{DynamicResource Add_SelectGroup}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,9" />
        <ListBox x:Name="GroupList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,7" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Click="Group_Click" AutomationProperties.Name="{Binding Name}" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{Binding Accent, Converter={StaticResource HexBrush}}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#EEF3FA" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ItemCount}" Foreground="#66758D" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Content="{DynamicResource Common_Cancel}" Width="80" HorizontalAlignment="Left" IsCancel="True" />
            <Button x:Name="CreateAndAddButton" Content="{DynamicResource Add_CreateAndAdd}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Click="CreateAndAdd_Click" AutomationProperties.AutomationId="CreateAndAdd" />
        </Grid>
    </Grid>
</Window>

