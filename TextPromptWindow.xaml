<Window x:Class="MiniDesk.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" SizeToContent="Height" MinHeight="245" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" Title="MiniDesk" ShowInTaskbar="False" Language="{DynamicResource CurrentLanguage}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="Label" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,9" />
        <TextBox x:Name="Input" Grid.Row="2" Height="40" FontSize="14" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Common_Cancel}" Width="78" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="{DynamicResource Common_Confirm}" Width="78" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" AutomationProperties.AutomationId="Confirm" />
        </StackPanel>
    </Grid>
</Window>

